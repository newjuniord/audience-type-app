rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is accessing their own document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Check if user has admin role (in user document)
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // Check if a field is being changed
    function isFieldUnchanged(fieldName) {
      return !(fieldName in request.resource.data) || 
        (resource != null && request.resource.data[fieldName] == resource.data[fieldName]);
    }

    // --- Collection Rules ---

    // Users: Users can read/write their own profile. Admins can access all.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isOwner(userId) && 
        request.resource.data.get('role', 'customer') == 'customer' &&
        request.resource.data.get('canGenerateTempLinks', false) == false &&
        request.resource.data.get('tempLinksCount', 0) == 0;
      
      allow update: if isAdmin() || (
        isOwner(userId) && 
        isFieldUnchanged('role') && 
        isFieldUnchanged('canGenerateTempLinks') && 
        isFieldUnchanged('tempLinksCount')
      );
      
      allow delete: if isAdmin();
    }

    // Products, Courses, Ebooks, Services: Public read, Admin write.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
      match /modules/{moduleId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /ebooks/{ebookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders & Enrollments: Ownership based access.
    match /orders/{orderId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (
        resource.data.userId == /databases/$(database)/documents/users/$(request.auth.uid) || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow create: if isAuthenticated();
      allow read, update: if isAuthenticated() && (
        resource.data.userId == /databases/$(database)/documents/users/$(request.auth.uid) || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Referrals: Referrer can read their own. Admin can read all.
    match /referrals/{referralId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.referrerId == /databases/$(database)/documents/users/$(request.auth.uid) ||
          resource.data.referrerId == request.auth.uid
        )
      );
      allow write: if isAdmin(); // Referrals created by admin or backend
    }

    // Temp Links: NO direct client access (handled via Cloud Functions/API)
    match /temp_links/{tokenId} {
      allow read, write: if false; 
    }

    // Admin Logs: Admin read only.
    match /admin_logs/{logId} {
        allow read: if isAdmin();
        allow write: if false; // Only from server
    }

    // Other Collections
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == /databases/$(database)/documents/users/$(request.auth.uid) || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    match /bookings/{bookingId} {
      allow create: if isAuthenticated();
      allow read, update: if isAuthenticated() && (
        resource.data.userId == /databases/$(database)/documents/users/$(request.auth.uid) || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /bookingApplications/{applicationId} {
      allow create: if isAuthenticated();
      allow read, update: if isAuthenticated() && (
        resource.data.userId == /databases/$(database)/documents/users/$(request.auth.uid) || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /assets/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /support_messages/{messageId} {
      allow read, delete: if isAdmin();
      allow create: if true;
    }
  }
}
