rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Fonctions Utilitaires ---

    // Vérifie si l'utilisateur est connecté
    function isAuthenticated() {
      return request.auth != null;
    }

    // Vérifie si l'utilisateur accède à son propre document (comparaison par UID)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Vérifie si l'utilisateur a le rôle admin
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Fonction générique pour vérifier la propriété d'un document (gère String et Reference)
    function isDataOwner(field) {
      return isAuthenticated() && (
        request.auth.uid == resource.data[field] || 
        resource.data[field] == /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    // Vérifie si un champ reste inchangé
    function isFieldUnchanged(fieldName) {
      return !(fieldName in request.resource.data) || 
        (resource != null && request.resource.data[fieldName] == resource.data[fieldName]);
    }

    // --- Règles des Collections ---

    // Utilisateurs : Lecture/Ecriture propre. Admin a tout accès.
    match /users/{userId} {
      // Un utilisateur peut tout lire sur son propre document
      allow read: if isOwner(userId) || isAdmin();
      
      // Uniquement recherche par Admin
      allow list: if isAdmin();

      allow create: if isAdmin() || (isAuthenticated() && isOwner(userId) && 
        request.resource.data.get('role', 'customer') == 'customer' &&
        request.resource.data.get('canGenerateTempLinks', false) == false &&
        request.resource.data.get('tempLinksCount', 0) == 0);
      
      allow update: if isAdmin() || (
        isOwner(userId) && 
        isFieldUnchanged('role') && 
        isFieldUnchanged('canGenerateTempLinks') && 
        isFieldUnchanged('tempLinksCount')
      );
      
      allow delete: if isAdmin();
    }

    // Produits, Cours, Ebooks, Services : Lecture publique, Écriture Admin.
    match /products/{productId} { allow read: if true; allow write: if isAdmin(); }
    match /courses/{courseId} { allow read: if true; allow write: if isAdmin(); }
    match /modules/{moduleId} { allow read: if true; allow write: if isAdmin(); }
    match /ebooks/{ebookId} { allow read: if true; allow write: if isAdmin(); }
    match /services/{serviceId} { allow read: if true; allow write: if isAdmin(); }
    match /assets/{assetId} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{settingId} { allow read: if true; allow write: if isAdmin(); }
    match /funnels/{funnelId} { allow read: if true; allow write: if isAdmin(); }

    // Cadeaux / Bonus (Kado) : Lecture publique (pour affichage), écriture Admin.

    // Commandes (Orders)
    match /orders/{orderId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin() || isDataOwner('userId');
      allow update, delete: if isAdmin();
    }

    // Inscriptions (Enrollments)
    match /enrollments/{enrollmentId} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin() || isDataOwner('userId');
      allow delete: if isAdmin();
    }

    // Demandes de réservation (Booking Applications) : contiennent des données
    // personnelles (téléphone, sujet). Lecture strictement limitée au client et à l'admin.
    match /bookingApplications/{applicationId} {
      allow create: if isAuthenticated() && request.resource.data.usersId == request.auth.uid;
      allow read, update: if isAdmin() || isDataOwner('usersId'); // Utilise usersId
      allow delete: if isAdmin();
    }

    // Créneaux de service : miroir PUBLIC et sans donnée personnelle des réservations.
    // Permet à n'importe quel visiteur de voir quels horaires sont déjà pris, sans jamais
    // exposer qui a réservé ni pourquoi.
    match /serviceSlots/{slotId} {
      allow read: if true;

      allow create: if isAuthenticated() && request.resource.data.heldBy == request.auth.uid;

      // Le détenteur gère son créneau (payer, libérer, annuler).
      // Un autre client ne peut le reprendre que s'il n'est pas payé ET que la
      // réservation temporaire a expiré — c'est la garantie anti-double-réservation.
      // `holdExpiresAt` est un Timestamp : comparaison directe avec l'horloge serveur,
      // sans arithmétique de millisecondes. Un document ancien sans ce champ est
      // considéré comme expiré (date par défaut à l'epoch), donc reprenable.
      allow update: if isAdmin()
        || (isAuthenticated() && resource.data.heldBy == request.auth.uid)
        || (isAuthenticated()
            && request.resource.data.heldBy == request.auth.uid
            && resource.data.status != 'booked'
            && request.time > resource.data.get('holdExpiresAt', timestamp.value(0)));

      allow delete: if isAdmin();
    }

    // Avis (Reviews)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isDataOwner('userId');
    }

    // Réservations directes (Bookings)
    match /bookings/{bookingId} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin() || isDataOwner('userId');
      allow delete: if isAdmin();
    }

    // Liens temporaires : Accès interdit en direct (via API uniquement)
    match /temp_links/{tokenId} { allow read, write: if false; }

    // Magic Links (Connexion sans mot de passe) : Lecture unitaire publique, écriture serveur
    match /magic_links/{tokenId} {
      allow get: if true;
      allow list, write: if false;
    }

    // Logs Admin
    match /admin_logs/{logId} { allow read: if isAdmin(); allow write: if false; }

    // Support
    match /support_messages/{messageId} {
      allow read, delete: if isAdmin();
      allow create: if true;
    }

    // Alertes / Notifications
    match /alerts/{alertId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || isAuthenticated();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
      );
    }
    
    // Surveys
    match /surveys/{surveyId} {
      allow read: if isAdmin() || resource.data.isActive == true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responseCount']) &&
        request.resource.data.responseCount == resource.data.responseCount + 1
      );

      match /responses/{responseId} {
        allow create: if true;
        allow read, update, delete: if isAdmin();
      }
    }

    // Gifts
    match /gifts/{giftId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentUsesCount']) &&
        request.resource.data.currentUsesCount == resource.data.currentUsesCount + 1
      );
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Support Chat
    match /chats/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

  }
}
