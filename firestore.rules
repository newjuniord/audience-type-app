rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Fonctions Utilitaires ---

    // Vérifie si l'utilisateur est connecté
    function isAuthenticated() {
      return request.auth != null;
    }

    // Vérifie si l'utilisateur accède à son propre document (comparaison par UID)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Vérifie si l'utilisateur a le rôle admin
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Fonction générique pour vérifier la propriété d'un document (gère String et Reference)
    function isDataOwner(field) {
      return isAuthenticated() && (
        request.auth.uid == resource.data[field] || 
        resource.data[field] == /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    // Vérifie si un champ reste inchangé
    function isFieldUnchanged(fieldName) {
      return !(fieldName in request.resource.data) || 
        (resource != null && request.resource.data[fieldName] == resource.data[fieldName]);
    }

    // --- Règles des Collections ---

    // Utilisateurs : Lecture/Ecriture propre. Admin a tout accès.
    match /users/{userId} {
      // Un utilisateur peut tout lire sur son propre document
      allow read: if isOwner(userId) || isAdmin();
      
      // Autorise la RECHERCHE par email (pour la connexion)
      allow list: if isAdmin() || (
        isAuthenticated() && 
        request.query.limit <= 1 && 
        request.query.filters.email == request.auth.token.email
      );

      allow create: if isAuthenticated() && isOwner(userId) && 
        request.resource.data.get('role', 'customer') == 'customer' &&
        request.resource.data.get('canGenerateTempLinks', false) == false &&
        request.resource.data.get('tempLinksCount', 0) == 0;
      
      allow update: if isAdmin() || (
        isOwner(userId) && 
        isFieldUnchanged('role') && 
        isFieldUnchanged('canGenerateTempLinks') && 
        isFieldUnchanged('tempLinksCount')
      );
      
      allow delete: if isAdmin();
    }

    // Produits, Cours, Ebooks, Services : Lecture publique, Écriture Admin.
    match /products/{productId} { allow read: if true; allow write: if isAdmin(); }
    match /courses/{courseId} { 
      allow read: if true; allow write: if isAdmin();
      match /modules/{moduleId} { allow read: if true; allow write: if isAdmin(); }
    }
    match /ebooks/{ebookId} { allow read: if true; allow write: if isAdmin(); }
    match /services/{serviceId} { allow read: if true; allow write: if isAdmin(); }
    match /assets/{assetId} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{settingId} { allow read: if true; allow write: if isAdmin(); }

    // Commandes (Orders)
    match /orders/{orderId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin() || isDataOwner('userId');
      allow update, delete: if isAdmin();
    }

    // Inscriptions (Enrollments)
    match /enrollments/{enrollmentId} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin() || isDataOwner('userId');
      allow delete: if isAdmin();
    }

    // Demandes de réservation (Booking Applications)
    match /bookingApplications/{applicationId} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin() || isDataOwner('usersId'); // Utilise usersId
      allow delete: if isAdmin();
    }

    // Parrainages (Referrals)
    match /referrals/{referralId} {
      allow read: if isAdmin() || isDataOwner('referrerId') || isDataOwner('refereeId');
      allow write: if isAdmin();
    }

    // Avis (Reviews)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isDataOwner('userId');
    }

    // Réservations directes (Bookings)
    match /bookings/{bookingId} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin() || isDataOwner('userId');
      allow delete: if isAdmin();
    }

    // Liens temporaires : Accès interdit en direct (via API uniquement)
    match /temp_links/{tokenId} { allow read, write: if false; }

    // Logs Admin
    match /admin_logs/{logId} { allow read: if isAdmin(); allow write: if false; }

    // Support
    match /support_messages/{messageId} {
      allow read, delete: if isAdmin();
      allow create: if true;
    }
  }
}
